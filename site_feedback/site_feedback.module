<?php

/**
* @file
* Provides hooks for the Site Feedback module.
*/
function site_feedback_page_attachments(array &$attachments) {
  // Do not load the feedback UI on Drupal administration pages.
  if (\Drupal::service('router.admin_context')->isAdminRoute()) {
    return;
  }

  $config = \Drupal::config('site_feedback.settings');

  if (!$config->get('feedback_button_enabled')) {
    return;
  }

  $attachments['#attached']['library'][] = 'site_feedback/feedback';
}