/**
 * Entity builder for Content Access Restriction fields.
 */
function content_access_restriction_entity_builder($entity_type, NodeInterface $entity, array &$form, FormStateInterface $form_state) {

  // Only process nodes.
  if ($entity->getEntityTypeId() !== 'node') {
    return;
  }

  /**
   * Restrict Roles
   */
  $selected_roles = array_filter(
    (array) $form_state->getValue('field_restrict_roles_custom')
  );

  // Administrator is handled separately.
  $selected_roles = array_diff($selected_roles, ['administrator']);

  $role_values = [];

  foreach ($selected_roles as $role) {
    $role_values[] = [
      'value' => $role,
    ];
  }

  $entity->set('field_restrict_roles', $role_values);

  /**
   * Restrict Users
   */
  $selected_users = (array) $form_state->getValue('field_restrict_users_custom');

  $user_values = [];

  foreach ($selected_users as $user) {
    if (!empty($user['target_id'])) {
      $user_values[] = [
        'target_id' => $user['target_id'],
      ];
    }
  }

  $entity->set('field_restrict_users', $user_values);

  /**
   * Restrict Action
   */
  $action = $form_state->getValue('field_restrict_action_custom');

  if (!in_array($action, ['403', '404'], TRUE)) {
    $action = '403';
  }

  $entity->set('field_restrict_action', $action);

  /**
   * Administrator Bypass
   */
  $entity->set(
    'field_restrict_bypass_admin',
    $form_state->getValue('field_restrict_bypass_admin_custom') ? 1 : 0
  );
}